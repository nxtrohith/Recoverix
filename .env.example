MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=hackathon

# ---------------------------------------------------------------------------
# Sarvam Instant Outbound (driver phone calls)
# Dashboard → Settings / Voice Agent / Connection
# ---------------------------------------------------------------------------
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
SARVAM_DEFAULT_LANGUAGE=Telugu
# Demo dial target until vehicles have a phone field
SARVAM_DEMO_DRIVER_PHONE=

# Optional call scripts (placeholders: {tracking} {shipment_id} {pickup_hub}
# {destination} {route} {vehicle_number} {required_action})
# SARVAM_SCRIPT_LATE_DETECTION=
# SARVAM_SCRIPT_RECOVERY_ASSIGN=
