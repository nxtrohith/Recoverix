MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=hackathon

# Server & Gateway configuration
PORT=3000
RECOVERY_API_HOST=127.0.0.1
RECOVERY_API_PORT=5055
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# TypeSafe Jev (System One) — explainable recovery judgments
# https://docs.typesafe.ai — leave empty to use code-only explanations
# ---------------------------------------------------------------------------
TYPESAFE_API_KEY=
# TYPESAFE_ENABLED=true
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Demo: cache recovery analyze/calculate results in-memory (seconds). 0 = off.
# RECOVERY_ANALYSIS_CACHE_TTL_SEC=600

# ---------------------------------------------------------------------------
# Sarvam Instant Outbound (driver phone calls)
# Dashboard → Settings / Voice Agent / Connection
# ---------------------------------------------------------------------------
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
SARVAM_DEFAULT_LANGUAGE=Telugu
# Demo dial target until vehicles have a phone field
SARVAM_DEMO_DRIVER_PHONE=

# Optional call scripts (placeholders: {tracking} {shipment_id} {pickup_hub}
# {destination} {route} {vehicle_number} {required_action})
# SARVAM_SCRIPT_LATE_DETECTION=
# SARVAM_SCRIPT_RECOVERY_ASSIGN=

# Driver mobile app (Expo) — copy into mobile-driver-app/.env as well
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
