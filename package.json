{
  "name": "conv-software-hackathon",
  "version": "1.0.0",
  "description": "Hackathon app with Mongoose MongoDB connection",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "seed": "node src/seed.js",
    "db:cleanup": "node scripts/cleanup_database.js",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "frontend": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "recovery:demo": "uv run python scripts/demo_orchestrator.py",
    "recovery:api": "uv run python -m graph.api_server --host 127.0.0.1 --port 5055",
    "seed:demo-misplaced": "uv run python scripts/seed_demo_misplaced.py",
    "seed:workflow-visuals": "uv run python scripts/seed_workflow_visuals.py",
    "test:expected-actual": "uv run python scripts/test_expected_actual.py",
    "test:recovery-workflow": "uv run python scripts/test_recovery_workflow.py",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nxtrohith/Conv-Software-Hackathon.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/nxtrohith/Conv-Software-Hackathon/issues"
  },
  "homepage": "https://github.com/nxtrohith/Conv-Software-Hackathon#readme",
  "dependencies": {
    "dotenv": "^18.0.0",
    "mongoose": "^9.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
